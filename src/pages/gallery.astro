---
import GalleryGrid from '~/components/gallery/GalleryGrid.astro';
import type { GalleryImage } from '~/components/gallery/GalleryGrid.astro';
import GalleryLightbox from '~/components/gallery/GalleryLightbox.astro';
import fallbackData from '~/data/gallery.json';
import ScaffoldLayout from '~/layouts/ScaffoldLayout.astro';

/**
 * Gallery data loading strategy (build-time):
 *
 * 1. If GALLERY_INDEX_URL env is set → fetch from R2 public URL
 * 2. Otherwise → use local gallery.json (mock / fallback)
 *
 * Set GALLERY_INDEX_URL in Vercel env vars to point to your R2 index:
 *   e.g. https://gallery.yourdomain.com/gallery/index.json
 */
const GALLERY_INDEX_URL = import.meta.env.GALLERY_INDEX_URL;

let images: GalleryImage[] = [];

if (GALLERY_INDEX_URL) {
	try {
		const resp = await fetch(GALLERY_INDEX_URL);
		if (resp.ok) {
			const data = await resp.json();
			images = data.images || [];
		} else {
			console.warn(
				`[gallery] Failed to fetch R2 index: ${resp.status}, using fallback`,
			);
			images = fallbackData.images;
		}
	} catch (e) {
		console.warn(`[gallery] Fetch error: ${e}, using fallback`);
		images = fallbackData.images;
	}
} else {
	images = fallbackData.images;
}
---

<ScaffoldLayout
	title="Gallery"
	description="Pinterest 灵感图库"
	currentNav="Gallery"
>
	<div class="gallery-header">
		<h1>Gallery</h1>
		<p>{images.length} photos</p>
	</div>
	{images.length > 0 ? (
		<GalleryGrid images={images} />
	) : (
		<p class="gallery-empty">还没有图片，邮件管道配置好后会自动收集。</p>
	)}
	<GalleryLightbox />
</ScaffoldLayout>

<style>
	.gallery-header {
		margin-bottom: 2rem;
	}

	.gallery-header h1 {
		font-size: 2.25rem;
		font-weight: 700;
		margin: 0;
		color: inherit;
	}

	.gallery-header p {
		margin: 0.25rem 0 0;
		opacity: 0.55;
		font-size: 0.9rem;
	}

	.gallery-empty {
		text-align: center;
		padding: 4rem 1rem;
		opacity: 0.5;
		font-size: 1rem;
	}
</style>
